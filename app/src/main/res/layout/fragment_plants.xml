<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plants_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green" />

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search"
            style="@style/Widget.PlantGreenCare.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/primary_green_dark"
            app:endIconMode="clear_text"
            app:endIconTint="@color/primary_green_dark"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/box_stroke_selector"
            app:boxStrokeWidth="1.5dp"
            app:boxStrokeWidthFocused="2.5dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_plants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/plants_search_hint"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:paddingHorizontal="14dp"
                android:paddingVertical="14dp"
                android:textColor="@color/input_text"
                android:textColorHint="@color/text_hint"
                android:textCursorDrawable="@drawable/cursor_green"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Horizontal Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_plant_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_needs_care"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_needs_care" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_overdue"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_overdue" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_up_to_date"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_up_to_date" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty_plants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_plants"
                android:background="@drawable/bg_plant_placeholder"
                android:padding="16dp"
                android:contentDescription="@string/plants_empty_message" />

            <TextView
                android:id="@+id/tv_empty_plants_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/plants_empty_message"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:gravity="center" />
        </LinearLayout>

        <!-- Plants RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_plants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_plant_card" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_plant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:backgroundTint="@color/primary_green"
        android:textColor="@color/white"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        android:text="@string/action_add_plant"
        android:contentDescription="@string/action_add_plant" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
