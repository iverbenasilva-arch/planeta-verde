<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/iv_history_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_plant_placeholder"
        android:src="@drawable/ic_check"
        android:padding="8dp"
        android:contentDescription="@string/details_history" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_history_type_and_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="22/09/2026 — Rega realizada"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_history_notes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Solo estava bem seco"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
