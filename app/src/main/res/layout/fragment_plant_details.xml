<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Fixed Top App Bar - Permanently Visible Back and Actions -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_plant_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_back_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary_green_dark"
                android:contentDescription="@string/action_cancel" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/details_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark" />

            <ImageButton
                android:id="@+id/btn_share_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@color/primary_green_dark"
                android:contentDescription="@string/action_share" />

            <ImageButton
                android:id="@+id/btn_edit_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="@color/primary_green_dark"
                android:contentDescription="@string/action_edit_plant" />

            <ImageButton
                android:id="@+id/btn_delete_details"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="@color/status_error"
                android:contentDescription="@string/action_delete_plant" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:paddingBottom="48dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <!-- Plant Hero Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_details_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@drawable/plant_care_icon"
                android:layout_marginHorizontal="16dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large"
                android:contentDescription="@string/details_title" />

            <!-- Plant Header Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_details_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jiboia"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_details_scientific"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Epipremnum aureum"
                    android:textSize="15sp"
                    android:textStyle="italic"
                    android:textColor="@color/text_secondary" />

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tv_details_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_plant_placeholder"
                        android:text="Local: Sala"
                        android:textSize="12sp"
                        android:textColor="@color/primary_green_dark" />

                    <TextView
                        android:id="@+id/tv_details_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_plant_placeholder"
                        android:text="Luz indireta"
                        android:textSize="12sp"
                        android:textColor="@color/primary_green_dark" />

                    <TextView
                        android:id="@+id/tv_details_humidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/bg_plant_placeholder"
                        android:text="Umidade moderada"
                        android:textSize="12sp"
                        android:textColor="@color/primary_green_dark" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_details_acquisition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Data de aquisição: 15/05/2025"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_details_observations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Observações: Regar quando o solo estiver seco na superfície."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <!-- Action Button: Registrar Cuidado Geral -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_details_register_care"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="50dp"
                    android:backgroundTint="@color/primary_green_dark"
                    android:textColor="@color/white"
                    android:text="@string/action_register_care"
                    app:icon="@drawable/ic_check"
                    app:iconTint="@color/white" />

                <!-- Google Toxicity & Care Information Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/card_border"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_shield_alert"
                                android:contentDescription="@string/toxicity_section_title" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/toxicity_section_title"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_green_dark" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/toxicity_desc"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_details_google_toxicity"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:minHeight="44dp"
                            android:text="@string/btn_google_toxicity"
                            android:textSize="12sp"
                            android:textColor="#C62828"
                            app:icon="@drawable/ic_open_in_new"
                            app:iconTint="#C62828" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_details_google_care"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="44dp"
                            android:text="@string/btn_google_care_tips"
                            android:textSize="12sp"
                            android:textColor="@color/primary_green_dark"
                            app:icon="@drawable/ic_search"
                            app:iconTint="@color/primary_green_dark" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Próximos Cuidados -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/details_next_cares"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:id="@+id/layout_schedules_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

                <!-- Section: Histórico de Cuidados -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/details_history"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_no_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="16dp"
                    android:gravity="center"
                    android:text="@string/details_no_history"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_care_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_care_history" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
