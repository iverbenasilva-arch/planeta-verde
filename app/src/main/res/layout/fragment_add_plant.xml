<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Fixed Top App Bar - Always Visible so Back Button is Permanently Accessible -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_add_plant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_back_add_plant"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/primary_green_dark"
                android:contentDescription="@string/action_cancel" />

            <TextView
                android:id="@+id/tv_add_edit_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/add_plant_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark" />

            <ImageButton
                android:id="@+id/btn_save_toolbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check"
                app:tint="@color/primary_green_dark"
                android:contentDescription="@string/action_save" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Form Content Under Fixed Top App Bar -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="48dp">

            <!-- Compact Responsive Photo Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_plant_preview"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/plant_care_icon"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                        android:contentDescription="@string/plants_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_photo"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/action_pick_photo"
                            android:textSize="13sp"
                            app:icon="@drawable/ic_photo_camera" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_remove_photo"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:layout_marginTop="2dp"
                            android:text="@string/action_remove_photo"
                            android:textColor="@color/status_error"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Plant Names Container (Supports adding up to 20 different plant names with add and delete in the same field) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_plant_names_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/field_name"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green_dark" />

                        <TextView
                            android:id="@+id/tv_plant_names_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 de 20 adicionadas"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green_dark" />
                    </LinearLayout>

                    <!-- Input row with Add (+) button in same field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_plant_name"
                            style="@style/Widget.PlantGreenCare.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/plant_name_hint_multi"
                            app:boxBackgroundColor="@color/white"
                            app:boxStrokeColor="@color/box_stroke_selector"
                            app:boxStrokeWidth="1.5dp"
                            app:boxStrokeWidthFocused="2.5dp"
                            app:hintTextColor="@color/primary_green_dark">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_plant_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:inputType="textCapWords"
                                android:imeOptions="actionDone"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="14dp"
                                android:textColor="@color/input_text"
                                android:textColorHint="@color/text_hint"
                                android:textCursorDrawable="@drawable/cursor_green"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_plant_name"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:backgroundTint="@color/primary_green_dark"
                            android:textColor="@color/white"
                            android:text="@string/action_add_name_to_list"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/white" />
                    </LinearLayout>

                    <!-- Dynamic Chips of plant names with individual delete (X) options in same field -->
                    <TextView
                        android:id="@+id/tv_plants_list_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/label_plants_to_add"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_plant_names"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Google Search & Toxicity Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_google_toxicity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_shield_alert"
                            android:contentDescription="@string/toxicity_section_title" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/toxicity_section_title"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_green_dark" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/toxicity_desc"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_search_toxicity_google"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="44dp"
                            android:text="@string/btn_google_toxicity"
                            android:textSize="12sp"
                            android:textColor="#C62828"
                            app:icon="@drawable/ic_open_in_new"
                            app:iconTint="#C62828" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_search_care_google"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="44dp"
                            android:text="@string/btn_google_care_tips"
                            android:textSize="12sp"
                            android:textColor="@color/primary_green_dark"
                            app:icon="@drawable/ic_search"
                            app:iconTint="@color/primary_green_dark" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_scientific_name"
                style="@style/Widget.PlantGreenCare.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_scientific_name"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/primary_green_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_scientific_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_location"
                style="@style/Widget.PlantGreenCare.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_location"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/primary_green_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_acquisition_date"
                style="@style/Widget.PlantGreenCare.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_acquisition_date"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:endIconTint="@color/primary_green_dark"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/primary_green_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_acquisition_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Light & Humidity Dropdowns in Responsive Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_light"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:hint="@string/field_light_level"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2.5dp"
                    app:hintTextColor="@color/primary_green_dark"
                    app:endIconTint="@color/primary_green_dark"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp">

                    <AutoCompleteTextView
                        android:id="@+id/actv_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="none"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_humidity"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:hint="@string/field_humidity_level"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2.5dp"
                    app:hintTextColor="@color/primary_green_dark"
                    app:endIconTint="@color/primary_green_dark"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp">

                    <AutoCompleteTextView
                        android:id="@+id/actv_humidity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="none"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_observations"
                style="@style/Widget.PlantGreenCare.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_observations"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:hintTextColor="@color/primary_green_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_observations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:inputType="textMultiLine"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@drawable/cursor_green"
                    android:textSize="16sp"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Configuração dos Cuidados Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/header_care_config"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green_dark" />

            <!-- Rega Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_water_drop"
                            app:tint="@color/primary_green_dark"
                            android:contentDescription="@string/watering_label" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/watering_label"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_watering"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_watering_freq"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/frequency_label"
                        app:boxBackgroundColor="@color/white"
                        app:boxStrokeColor="@color/box_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxStrokeWidthFocused="2.5dp"
                        app:hintTextColor="@color/primary_green_dark"
                        app:endIconTint="@color/primary_green_dark"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp">

                        <AutoCompleteTextView
                            android:id="@+id/actv_watering_freq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:inputType="none"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="14dp"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/text_hint"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Adubação Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_plants"
                            app:tint="@color/primary_green_dark"
                            android:contentDescription="@string/fertilizing_label" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/fertilizing_label"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_fertilizing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_fertilizing_freq"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/frequency_label"
                        app:boxBackgroundColor="@color/white"
                        app:boxStrokeColor="@color/box_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxStrokeWidthFocused="2.5dp"
                        app:hintTextColor="@color/primary_green_dark"
                        app:endIconTint="@color/primary_green_dark"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp">

                        <AutoCompleteTextView
                            android:id="@+id/actv_fertilizing_freq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:inputType="none"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="14dp"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/text_hint"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Poda Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/card_border"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/primary_green_dark"
                            android:contentDescription="@string/pruning_label" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/pruning_label"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_pruning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_pruning_freq"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/frequency_label"
                        app:boxBackgroundColor="@color/white"
                        app:boxStrokeColor="@color/box_stroke_selector"
                        app:boxStrokeWidth="1.5dp"
                        app:boxStrokeWidthFocused="2.5dp"
                        app:hintTextColor="@color/primary_green_dark"
                        app:endIconTint="@color/primary_green_dark"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp">

                        <AutoCompleteTextView
                            android:id="@+id/actv_pruning_freq"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:inputType="none"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="14dp"
                            android:textColor="@color/input_text"
                            android:textColorHint="@color/text_hint"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Save Button at Bottom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_plant"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:minHeight="54dp"
                android:backgroundTint="@color/primary_green_dark"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/white"
                android:text="@string/action_save" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
